IDD_AUTOUPDATE_DIALOG DIALOGEX 0, 0, 460, 334
STYLE WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Z"
FONT 9, "宋体", 0, 0, 0x1
BEGIN
    CONTROL         "开始游戏",IDC_BTN_PLAY,"Button",BS_OWNERDRAW | 
                    WS_TABSTOP,283,247,50,14
    CONTROL         "游戏设置(&S)",IDC_BTN_SETTING,"Button",BS_OWNERDRAW | 
                    WS_DISABLED | WS_TABSTOP,361,241,50,14
    CONTROL         "关闭(&C)",IDC_BTN_CLOSE,"Button",BS_OWNERDRAW | 
                    WS_TABSTOP,281,275,50,14
    CONTROL         "",IDC_EXPLORER1,"{8856F961-340A-11D0-A96B-00C04FD705A2}",
                    WS_TABSTOP,70,37,243,113
    LTEXT           "开始升级...",IDC_STATIC_PROGRESSMSG,15,210,45,8
    LTEXT           "",IDC_STATIC_SHOWCAPTION,23,23,50,8
    CONTROL         "Button3",IDC_BUTTON_MINIMIZE,"Button",BS_OWNERDRAW | 
                    WS_TABSTOP,373,104,26,17
    CONTROL         "Button4",IDC_BUTTON_CLOSE,"Button",BS_OWNERDRAW | 
                    WS_TABSTOP,388,42,25,15
    CONTROL         207,IDC_STATIC_MAINPROGRESS,"Static",SS_BITMAP | 
                    SS_NOTIFY,141,206,320,7
    CONTROL         205,IDC_STATIC_FILEPROGRESS,"Static",SS_BITMAP | 
                    SS_NOTIFY,141,223,320,7
END

