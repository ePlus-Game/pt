; UpdateDLL.def : Declares the module parameters for the DLL.

EXPORTS
    ; Explicit exports can go here
    Update_Init            @1 PRIVATE
    Update_UnInit          @2 PRIVATE
	Update_Start		   @3 PRIVATE
	Update_Cancel		   @4 PRIVATE
	Update_NextTime        @5 PRIVATE
	GetUpdateLock          @6 PRIVATE
	ReleaseUpdateLock      @7 PRIVATE			
